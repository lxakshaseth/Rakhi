<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bg1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b0819" />
      <stop offset="50%" stop-color="#5c0d27" />
      <stop offset="100%" stop-color="#19030a" />
    </linearGradient>
    <radialGradient id="glow1" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffd700" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#ffd700" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="600" height="600" fill="url(#bg1)" />
  <circle cx="300" cy="300" r="240" fill="url(#glow1)" />
  <circle cx="300" cy="300" r="180" fill="none" stroke="#d4af37" stroke-width="2" stroke-dasharray="6,6" opacity="0.6" />
  
  <!-- Sibling Silhouette / Art -->
  <g transform="translate(300, 260)">
    <circle cx="0" cy="0" r="60" fill="#781030" stroke="#d4af37" stroke-width="3" />
    <path d="M-25,-10 C-25,-25 0,-25 0,-10 C0,-25 25,-25 25,-10 C25,15 0,35 0,35 C0,35 -25,15 -25,-10 Z" fill="#f87171" />
  </g>
  
  <text x="300" y="380" font-family="Georgia, serif" font-size="34" font-weight="bold" fill="#fae19c" text-anchor="middle">2010</text>
  <text x="300" y="420" font-family="-apple-system, sans-serif" font-size="18" fill="#fef9ee" opacity="0.9" text-anchor="middle">Childhood Chaos &amp; Innocent Memories</text>
  <text x="300" y="450" font-family="-apple-system, sans-serif" font-size="14" fill="#d4af37" opacity="0.8" text-anchor="middle">✨ The Early Years ✨</text>
</svg>
